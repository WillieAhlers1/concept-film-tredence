{
  "name": "<Concept> concept film, draft 1",
  "tmp": "work",
  "prototype": {
    "dir": "proto",
    "file": "<short>.html",
    "warmup_s": 30,
    "keys": {"hide": "h", "replay": "r", "next": "ArrowRight"}
  },
  "narration": {
    "script": "narration.txt",
    "audio": "narr.wav",
    "transcript": "narr.txt",
    "prefix": "Host: ",
    "gap_s": 0.6,
    "cue_ids": "A1 B1 B2 B3 C1 C2 C3 D1 D2 E1 E2 F1 F2 G1 G2 H1 H2 I1 I2 J1 J2 K1 K2 L1 L2 M1 M2"
  },
  "voice": {"engine": "azure", "name": "en-US-AndrewMultilingualNeural", "rate": "0%"},
  "cues": "cues.json",
  "plan": "plan.json",
  "crossfade_s": 0.6,
  "capture": {"rate": 0.25, "width": 1920, "height": 1080, "jpeg_quality": 86},
  "graphics": {
    "file": "graphics.html",
    "simdata": "simdata.json",
    "title": "<Concept> film graphics",
    "concept_label": "Concept demo · Fictitious data",
    "images": {"establishing": "images/night.jpg", "arrival": "images/arrival.jpg", "desk": "images/desk.jpg"},
    "night": {"eyebrow": "<Weekday> · 2:00 AM", "title": "While <Persona first name> *sleeps*"},
    "sim": {
      "eyebrow": "<What runs overnight> · overnight run",
      "title": "Playing <weekday> *forward*",
      "counter_unit": "simulated days",
      "counter_baseline": 2000,
      "phase": {"baseline": "<Today's order, e.g. Arrival order>", "search": "Trying <N> orders", "optimized": "<Engine name> order"},
      "stats": [
        {"label": "<Primary outcome, e.g. Deadline cases on time>", "left": 560, "before_color": "#f48120",
         "before": "{t[today_order][ontime_files]:.1f} of <total>", "after": "{t[iq_order][ontime_files]:.0f} of <total>"},
        {"label": "<Value metric, e.g. Expected to fund>", "left": 1010, "before_color": "#ffffff",
         "before": "${t[today_order][ev_m]:.2f}M", "after": "${t[iq_order][ev_m]:.2f}M"}
      ],
      "late_share": 0.4,
      "badge": {"late": "Often too late", "ok": "On time"},
      "no_deadline_label": "no deadline",
      "axis": {
        "start": 8, "end": 17,
        "ticks": [[8, "8 AM"], [10, "10 AM"], [12, "12 PM"], [14, "2 PM"], [16, "4 PM"], [17, "5 PM"]],
        "overflow": [32, 36.5], "overflow_label": "Tomorrow",
        "bands": [[11, 11.75], [12.5, 13]],
        "no_deadline_from": 90,
        "day_names": ["today", "tomorrow", "Thu", "Fri"]
      },
      "product_short": {}
    },
    "morning": {
      "clock_before": "<Day, Mon DD> · 7:12 AM",
      "clock_after": "<Day, Mon DD> · 7:29 AM",
      "name": "<Persona full name>",
      "role": "<Role> · <Team>",
      "queue_kicker": "<Work list name>",
      "queue_big": "<N items>",
      "queue_small": "<What makes today hard, one line>"
    },
    "endcard": {
      "kicker": "Concept film",
      "title": "<The business shift, as one sentence with a *key phrase*>",
      "line": "Concept demo · Fictitious data · <Month YYYY>"
    }
  },
  "music": {"file": "music.wav", "seed": 7},
  "mix": {"file": "mix.wav", "music_db": -14, "voice_lufs": -16, "limit": 0.89},
  "captions": {"enabled": true, "file": "film.ass", "font": "Poppins Medium", "size": 34, "max_chars": 72, "margin_v": 80},
  "output": {"file": "film.mp4", "crf": 19},
  "review": {"every_s": 7}
}
